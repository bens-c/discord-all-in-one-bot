# Docker: domain only, without https:// or path
DASHBOARD_DOMAIN=dashboard.example.com
DISCORD_TOKEN=
GUILD_ID=
CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Direct npm start only; Docker Compose sets this automatically.
DISCORD_REDIRECT_URI=https://dashboard.example.com/api/auth/callback/discord
# Generate with: openssl rand -hex 32
SESSION_SECRET=
